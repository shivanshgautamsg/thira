# =============================================================
# THIRA — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.

# ----- LLM Provider -----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://thira:thira_dev@localhost:5432/thira
DATABASE_URL_SYNC=postgresql://thira:thira_dev@localhost:5432/thira

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- Gmail (Phase 2) -----
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# ----- Google Calendar (Phase 2) -----
# GOOGLE_CALENDAR_CREDENTIALS=

# ----- GitHub (Phase 2+) -----
# GITHUB_TOKEN=

# ----- JARVIS -----
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
